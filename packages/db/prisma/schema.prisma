// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  username     String     @unique
  role         Role       @default(USER)
  comments     Comments[]
  // subscriptions: Users who subscribe to this user
  subscribers  User[]     @relation("UserSubscribers")
  // Reverse fields for self-relations
  subscribedTo User[]     @relation("UserSubscribers")

  streams Stream[]

  refreshToken RefreshToken?

  agentConnection AgentConnection?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  aiAgentBot AI_Agent_Bot?
}

enum Role {
  USER
  ADMIN
}

model Stream {
  id             String     @id @default(uuid())
  title          String?
  description    String?
  isLive         Boolean
  thumbnail      String?
  playBackKey    String?
  like           Int        @default(0)
  dislike        Int        @default(0)
  viewers        Int        @default(0)
  subscriberOnly Boolean
  comments       Comments[]
  userId         String
  chat           Chat?
  user           User       @relation(fields: [userId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Chat {
  id        String    @id @default(uuid())
  streamId  String    @unique
  stream    Stream    @relation(fields: [streamId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  watching  Int       @default(0)
  message   Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chatId    String   @unique
  chat      Chat     @relation(fields: [chatId], references: [id])
  username  String
}

model Comments {
  id        String   @id @default(uuid())
  message   String
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streamId String

  user   User   @relation(fields: [username], references: [username])
  stream Stream @relation(fields: [streamId], references: [id])
}

model AI_Agent_Bot {
  id               String   @id @default(uuid())
  telegramUsername String   @unique
  chats            UserContextData[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  agentConnectionId Int @unique
  agentConnection  AgentConnection @relation(fields: [agentConnectionId],references: [connection_id])
  user             User     @relation(fields: [userId], references: [id])

}

model TelegramBot {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AgentConnection {
  id             String   @id @default(uuid())
  jwt_token      String
  connection_id  Int  @unique
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  aiAgentBot     AI_Agent_Bot?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserContextData {
  id        String   @id @default(uuid())
  role      String
  content   String
  username  String?
  tool_name String?
  aiAgentBotId String
  aiAgentBot AI_Agent_Bot @relation(fields: [aiAgentBotId],references: [id])
  createdAt DateTime @default(now())
}