# Telegram bot token from @BotFather
BOT_TOKEN=

# Backend API base URL (include /api/v1)
HTTP_SERVER_URL=http://localhost:3000/api/v1

# PostgreSQL connection string (used via @repo/db)
DATABASE_URL=postgresql://user:password@localhost:5432/thestreaming

# Redis connection URL (used via @repo/redis)
REDIS_URL=redis://localhost:6379

# Google Gemini API key (optional; only needed for genAi model)
GEMINI_API_KEY=

# Ollama server host (optional; defaults to http://127.0.0.1:11434 in code)
OLLAMA_HOST=http://127.0.0.1:11434
