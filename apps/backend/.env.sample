# JWT secret for signing access and refresh tokens
JWT_SECRET_KEY=

# PostgreSQL connection string (used via @repo/db)
DATABASE_URL=postgresql://user:password@localhost:5432/thestreaming

# Backblaze B2 / S3-compatible storage
B2_REGION=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Runtime environment
NODE_ENV=development
